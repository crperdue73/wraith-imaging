### BEGIN INIT INFO
# Provides: WRAITHSnapinReplicator
# Required-Start: $local_fs $remote_fs $network $syslog $network $inetd
# Required-Stop: $local_fs $remote_fs $network $syslog $network $inetd
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# X-Interactive: true
# Short-Description: Start/Stop WRAITHSnapinReplicator
# Long-Description: Created by David Fear 
# Used to stop and start the WRAITHSnapinReplicator Service.
# WRAITHSnapinReplicator enacts upon the WRAITH System to replicate
# Snapins to nodes.  It only replicates if it is the master node.
### END INIT INFO

[Unit]
Description=WRAITHSnapinReplicator
After=syslog.target network.target network-online.target mysql.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
ExecStart=/usr/bin/env php /opt/wraith/service/WRAITHSnapinReplicator/WRAITHSnapinReplicator

[Install]
WantedBy=multi-user.target
